# Copy this file to .env in the project root before running Docker Compose.
# Generate unique secrets locally; do not commit the populated .env file.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_postgres_password
POSTGRES_DB=vftfarms_db

JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
FREE_SHIPPING_THRESHOLD=150000
DEFAULT_SHIPPING_FEE=25000
