# ==============================================================================
# VFT Farms Backend Environment Variables
# ==============================================================================

PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=vftfarms_db
DB_SYNCHRONIZE=false

# Authentication & Security
# Replace both placeholders with different cryptographically random values before production.
JWT_SECRET=replace_with_a_unique_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_of_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_EMAIL=replace_with_admin_email
ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_16_chars
ADMIN_FULL_NAME=VFT Farms Administrator
ADMIN_PHONE_NUMBER=replace_with_admin_phone_number

# Shipping Configuration
FREE_SHIPPING_THRESHOLD=150000
DEFAULT_SHIPPING_FEE=25000
