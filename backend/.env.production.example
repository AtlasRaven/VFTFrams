# ==============================================================================
# VFT FARMS BACKEND - PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================
PORT=4000
NODE_ENV=production

# Supabase / Neon PostgreSQL Connection String (Recommended)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require

# Alternatively, manual DB variables:
# DB_HOST=ep-xyz.neon.tech
# DB_PORT=5432
# DB_USERNAME=vft_user
# DB_PASSWORD=your_strong_password
# DB_DATABASE=vftfarms_db
# DB_SSL=true

# JWT Authentication
JWT_SECRET=vftfarms_production_secure_jwt_secret_key_2026_super_safe
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=vftfarms_production_refresh_token_secret_key_2026
JWT_REFRESH_EXPIRES_IN=30d

# Frontend CORS
CLIENT_URL=https://vftfarms.vercel.app
CORS_ORIGIN=*
